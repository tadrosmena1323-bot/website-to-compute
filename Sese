<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>Smart Home Simulator — Web</title>
  <style>
    html,body { height:100%; margin:0; font-family: Arial, sans-serif; background:#cfe9ff; }
    #game { position:fixed; inset:0; display:block; }
    #ui {
      position:fixed; right:12px; top:12px; width:220px;
      background: rgba(255,255,255,0.9); border-radius:10px; padding:10px; box-shadow:0 6px 18px rgba(0,0,0,0.15);
      font-size:14px; z-index:10;
    }
    #ui h3 { margin:0 0 8px 0; font-size:16px; }
    #energy { font-weight:700; margin-bottom:8px; }
    .btn { display:inline-block; margin:4px 4px 4px 0; padding:8px 10px; border-radius:6px; background:#1976d2; color:white; text-align:center; cursor:pointer; }
    .small { background:#4caf50; }
    #prompt { position:fixed; left:50%; transform:translateX(-50%); bottom:18px; background:rgba(0,0,0,0.6); color:white; padding:8px 12px; border-radius:18px; font-size:14px; z-index:10; display:none; }
    /* joystick */
    #joy-left, #joy-right { position:fixed; bottom:28px; width:120px; height:120px; border-radius:60px; background:rgba(0,0,0,0.15); display:flex; align-items:center; justify-content:center; z-index:9; }
    #joy-left { left:18px; }
    #joy-right { right:18px; display:none; } /* show only if needed */
    .stick { width:56px; height:56px; border-radius:28px; background:rgba(0,0,0,0.35); touch-action:none; }
    /* mobile controls visibility */
    @media (max-width:900px) {
      #joy-right { display:block; }
    }
    #topbar { position:fixed; left:12px; top:12px; z-index:10; }
    #modeToggle { padding:6px 8px; border-radius:6px; background:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.08); }
  </style>
</head>
<body>
  <canvas id="game"></canvas>

  <div id="ui">
    <h3>Smart Home (Day)</h3>
    <div id="energy">Energy: 0.00</div>
    <div>Temperature: <span id="tempVal">22</span>°C</div>
    <div style="margin-top:8px;">
      <div class="btn" id="incTemp">+ Temp</div>
      <div class="btn" id="decTemp">- Temp</div>
    </div>
    <div style="margin-top:8px;">
      <div class="btn" id="toggleAll">Toggle All Lights</div>
      <div class="btn small" id="switchMode">Enter Car (N/A)</div>
    </div>
    <div style="margin-top:6px; font-size:12px; color:#444;">Move: joystick (mobile) or WASD. Look: drag/right side or mouse.</div>
  </div>

  <div id="prompt">Press Interact</div>

  <div id="joy-left"><div class="stick" id="stick-left"></div></div>
  <div id="joy-right"><div class="stick" id="stick-right"></div></div>
  <div id="topbar"><div id="modeToggle" class="btn">Pointer Lock</div></div>

  <!-- Three.js from CDN -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.156.0/build/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.156.0/examples/js/controls/PointerLockControls.js"></script>

  <script>
  // Basic first-person smart-home demo using three.js
  (function(){
    const canvas = document.getElementById('game');
    const renderer = new THREE.WebGLRenderer({ canvas, antialias:true });
    renderer.setPixelRatio(window.devicePixelRatio || 1);
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xcfe9ff);

    // Camera / controls
    const camera = new THREE.PerspectiveCamera(70, window.innerWidth/window.innerHeight, 0.1, 200);
    camera.position.set(0,1.6,5);

    // pointer lock controls for desktop
    const controls = new THREE.PointerLockControls(camera, renderer.domElement);

    document.getElementById('modeToggle').addEventListener('click', ()=>{
      if (controls.isLocked) controls.unlock();
      else controls.lock();
    });

    controls.addEventListener('lock', ()=>{ document.getElementById('modeToggle').innerText = 'Exit Pointer'; });
    controls.addEventListener('unlock', ()=>{ document.getElementById('modeToggle').innerText = 'Pointer Lock';});

    // simple daytime light
    const hemi = new THREE.HemisphereLight(0xffffff, 0x444444, 1.0);
    hemi.position.set(0,50,0); scene.add(hemi);
    const sun = new THREE.DirectionalLight(0xffffff, 0.8);
    sun.position.set(10,20,10); scene.add(sun);

    // ground
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(200,200),
      new THREE.MeshStandardMaterial({ color:0xe6f2ff })
    );
    ground.rotation.x = -Math.PI/2; scene.add(ground);

    // simple house: floor and a few room walls (open roof)
    const floor = new THREE.Mesh(new THREE.BoxGeometry(8,0.1,8), new THREE.MeshStandardMaterial({color:0xffffff}));
    floor.position.set(0,0,0); scene.add(floor);

    // walls
    const wallMat = new THREE.MeshStandardMaterial({color:0xf7f7f7});
    const backWall = new THREE.Mesh(new THREE.BoxGeometry(8,2.8,0.12), wallMat);
    backWall.position.set(0,1.4,-4); scene.add(backWall);
    const leftWall = new THREE.Mesh(new THREE.BoxGeometry(0.12,2.8,8), wallMat);
    leftWall.position.set(-4,1.4,0); scene.add(leftWall);
    const rightWall = new THREE.Mesh(new THREE.BoxGeometry(0.12,2.8,8), wallMat);
    rightWall.position.set(4,1.4,0); scene.add(rightWall);

    // inner corridor wall
    const inner = new THREE.Mesh(new THREE.BoxGeometry(4,2.8,0.12), wallMat);
    inner.position.set(0,1.4,0.5); scene.add(inner);

    // door frame (interactive)
    const doorGroup = new THREE.Group();
    const door = new THREE.Mesh(new THREE.BoxGeometry(0.02, 1.8, 0.9), new THREE.MeshStandardMaterial({color:0x6b3f1b}));
    door.position.set(-0.45,0.9, -3.99); // set relative to hinge
    doorGroup.add(door);
    doorGroup.position.set(1.4,0,0); // hinge location
    scene.add(doorGroup);
    doorGroup.userData = { isDoor:true, open:false, hinge: doorGroup };

    // living room point light (smart light)
    function createSmartLight(x,y,z, color=0xfff1a5){
      const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.08,12,8), new THREE.MeshStandardMaterial({emissive:color, emissiveIntensity:1, color:0x222222}));
      bulb.position.set(x,y,z);
      const pl = new THREE.PointLight(0xfff1a5, 1.2, 6);
      pl.position.copy(bulb.position);
      scene.add(pl);
      scene.add(bulb);
      return { bulb, light:pl, on:true, energyPerSec:0.12 };
    }

    const lights = [
      createSmartLight(1.3,2.4, -1.0),
      createSmartLight(-1.2,2.4, 1.2),
      createSmartLight(0.4,2.4, -2.4)
    ];

    // some furniture boxes (visual)
    const sofa = new THREE.Mesh(new THREE.BoxGeometry(1.6,0.6,0.8), new THREE.MeshStandardMaterial({color:0xd9d9d9}));
    sofa.position.set(-1,0.45,-1.3); scene.add(sofa);
    const table = new THREE.Mesh(new THREE.BoxGeometry(0.8,0.05,0.8), new THREE.MeshStandardMaterial({color:0xcccccc}));
    table.position.set(0.1,0.4,-1.0); scene.add(table);

    // thermostat object (screen)
    const thermo = new THREE.Mesh(new THREE.BoxGeometry(0.14,0.22,0.02), new THREE.MeshStandardMaterial({color:0xeeeeee}));
    thermo.position.set(3.88,1.2,-1.2); scene.add(thermo);
    let temperature = 22;

    // energy model
    let energy = 0.0;

    // interact checking
    let prompt = document.getElementById('prompt');
    let currentTarget = null;

    // raycaster for interactions
    const raycaster = new THREE.Raycaster();
    const interactDistance = 2.2;

    // movement state
    let move = {forward:0, right:0};
    let velocity = new THREE.Vector3();
    const speedWalk = 2.8;

    // mobile joystick handling
    function simpleJoystick(left=true){
      const stick = left ? document.getElementById('stick-left') : document.getElementById('stick-right');
      let dragging = false, origin = {x:0,y:0};
      let val = {x:0,y:0};
      function start(e){
        dragging = true;
        const touch = e.touches ? e.touches[0] : e;
        origin.x = touch.clientX; origin.y = touch.clientY;
      }
      function moveEvent(e){
        if(!dragging) return;
        const touch = e.touches ? e.touches[0] : e;
        const dx = touch.clientX - origin.x;
        const dy = touch.clientY - origin.y;
        const max = 40;
        const nx = Math.max(-1, Math.min(1, dx/max));
        const ny = Math.max(-1, Math.min(1, dy/max));
        if(left){ move.right = nx; move.forward = -ny; stick.style.transform = `translate(${nx*30}px, ${ny*30}px)`; }
        else {
          // right stick controls look
          camera.rotation.x = Math.max(-1.2, Math.min(1.2, camera.rotation.x - ny*0.04));
          camera.rotation.y += nx*0.04;
          stick.style.transform = `translate(${nx*30}px, ${ny*30}px)`;
        }
      }
      function end(){ dragging=false; if(left){ move.right=0; move.forward=0; } stick.style.transform='translate(0,0)'; }
      // touch listeners
      stick.addEventListener('touchstart', start, {passive:false});
      window.addEventListener('touchmove', moveEvent, {passive:false});
      window.addEventListener('touchend', end, {passive:false});
      // mouse fallback for desktop dragging
      let mdown=false;
      stick.addEventListener('mousedown', (e)=>{ mdown=true; origin.x=e.clientX; origin.y=e.clientY;});
      window.addEventListener('mousemove', (e)=>{ if(!mdown) return; moveEvent(e); });
      window.addEventListener('mouseup', ()=>{ mdown=false; end(); });
    }
    simpleJoystick(true);
    simpleJoystick(false);

    // desktop keyboard
    const keys = {};
    window.addEventListener('keydown', (e)=>{ keys[e.key.toLowerCase()] = true; });
    window.addEventListener('keyup', (e)=>{ keys[e.key.toLowerCase()] = false; });

    // main loop
    const clock = new THREE.Clock();
    function animate(){
      const dt = clock.getDelta();

      // keyboard movement fallback
      if(keys['w']) move.forward = 1; else if(keys['s']) move.forward = -1; else if(!('touches' in window)) move.forward = 0;
      if(keys['a']) move.right = -1; else if(keys['d']) move.right = 1; else if(!('touches' in window)) move.right = 0;

      // compute movement in camera-space
      const forward = new THREE.Vector3(0,0,-1).applyQuaternion(camera.quaternion);
      forward.y = 0; forward.normalize();
      const right = new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion);
      right.y = 0; right.normalize();

      velocity.copy(forward).multiplyScalar(move.forward * speedWalk * dt);
      velocity.add(right.multiplyScalar(move.right * speedWalk * dt));
      // apply movement to controls' object (if pointerlock active use controls.getObject())
      const playerObj = controls.getObject ? controls.getObject() : camera;
      if (controls.isLocked && controls.getObject) {
        controls.getObject().position.add(velocity);
      } else {
        camera.position.add(velocity);
      }

      // physics: keep camera height
      if (controls.getObject && controls.getObject().position) {
        if (controls.getObject().position.y < 1.6) controls.getObject().position.y = 1.6;
      } else {
        if (camera.position.y < 1.6) camera.position.y = 1.6;
      }

      // energy update from lights
      for(const l of lights){
        if(l.on) energy += l.energyPerSec * dt;
      }
      document.getElementById('energy').innerText = 'Energy: ' + energy.toFixed(2);
      document.getElementById('tempVal').innerText = temperature;

      // interaction raycast from camera forward
      const origin = (controls.getObject && controls.getObject().position) ? controls.getObject().position.clone() : camera.position.clone();
      const dir = new THREE.Vector3(0,0,-1).applyQuaternion(camera.quaternion);
      raycaster.set(origin, dir);
      const intersects = raycaster.intersectObjects(scene.children, true);

      let found = null;
      for (let i=0;i<intersects.length;i++){
        const it = intersects[i];
        // check door
        let obj = it.object;
        if (obj.parent && obj.parent.userData && obj.parent.userData.isDoor) {
          if (it.distance < interactDistance) { found = {type:'door', obj: obj.parent}; break; }
        }
        // check lights (bulb spheres)
        if (it.object && it.object.geometry && it.object.geometry.type === 'SphereGeometry'){
          // approximate: sphere nodes we created for lights
          if (it.distance < interactDistance) { found = {type:'light', obj: it.object}; break; }
        }
        // check thermostat (by position)
        if (it.object === thermo && it.distance < interactDistance) { found = {type:'thermo', obj: thermo}; break; }
      }

      if (found) {
        currentTarget = found;
        prompt.style.display = 'block';
        prompt.innerText = 'Interact (' + found.type + ')';
      } else {
        currentTarget = null;
        prompt.style.display = 'none';
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();

    // Interact button (tap)
    function doInteract(){
      if (!currentTarget) return;
      if (currentTarget.type === 'door'){
        const grp = currentTarget.obj;
        const open = grp.userData.open;
        // rotate around hinge (y axis)
        const targetAngle = open ? 0 : Math.PI/2;
        grp.rotation.y = targetAngle;
        grp.userData.open = !open;
      } else if (currentTarget.type === 'light'){
        // find corresponding lights array item (by distance)
        const bulbObj = currentTarget.obj;
        let nearest = null; let nidx = -1;
        for (let i=0;i<lights.length;i++){
          const d = bulbObj.position.distanceTo(lights[i].bulb.position);
          if (nearest===null || d < nearest){ nearest = d; nidx = i; }
        }
        if (nidx >= 0){
          lights[nidx].on = !lights[nidx].on;
          lights[nidx].light.intensity = lights[nidx].on ? 1.2 : 0;
          lights[nidx].bulb.material.emissiveIntensity = lights[nidx].on ? 1 : 0.0;
        }
      } else if (currentTarget.type === 'thermo'){
        // open small UI - here we'll just bump temp +1
        temperature++;
      }
    }

    // Interact via tapping screen
    canvas.addEventListener('touchend', function(e){
      // if tap short and we have target, interact
      if (currentTarget) doInteract();
    });

    // Also add an on-screen button for desktop/mobile
    // create simple interaction when screen tapped near center
    window.addEventListener('keydown', (e)=>{ if (e.key === 'e') doInteract(); });

    // UI buttons
    document.getElementById('incTemp').addEventListener('click', ()=>{ temperature++; });
    document.getElementById('decTemp').addEventListener('click', ()=>{ temperature--; });
    document.getElementById('toggleAll').addEventListener('click', ()=>{
      for (let i=0;i<lights.length;i++){
        lights[i].on = !lights[i].on;
        lights[i].light.intensity = lights[i].on ? 1.2 : 0;
        lights[i].bulb.material.emissiveIntensity = lights[i].on ? 1 : 0;
      }
    });

    // resize
    window.addEventListener('resize', ()=>{ renderer.setSize(window.innerWidth,window.innerHeight); camera.aspect = window.innerWidth/window.innerHeight; camera.updateProjectionMatrix(); });

    // keep a small instruction on load
    setTimeout(()=>{ alert('Welcome! Use the left joystick to move and drag the right side to look (or use mouse). Tap near an object to interact (or press "E" on keyboard).'); }, 400);

  })();
  </script>
</body>
                                   </html>
                                   
